{
  "name": "video-player",
  "productName": "Video Player",
  "description": "Windows 11 style video player: HEVC/HDR/AV1/VP9/ProRes/MPEG-2 video and AC3/E-AC3/DTS/TrueHD audio with no codec installs, HW/SW decoding, audio output selection.",
  "author": "Video Player",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/outfit": "^5.1.0",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.videoplayer.desktop",
    "productName": "Video Player",
    "copyright": "Video Player",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "264",
            "265",
            "3g2",
            "3gp",
            "amv",
            "asf",
            "avi",
            "avs",
            "bik",
            "divx",
            "dv",
            "dvr-ms",
            "evo",
            "f4v",
            "flv",
            "h264",
            "h265",
            "hevc",
            "m2ts",
            "m2v",
            "m4v",
            "mkv",
            "mod",
            "mov",
            "mp4",
            "mp4v",
            "mpe",
            "mpeg",
            "mpg",
            "mts",
            "mxf",
            "nsv",
            "ogm",
            "ogv",
            "ogx",
            "qt",
            "rm",
            "rmvb",
            "tod",
            "tp",
            "trp",
            "ts",
            "vob",
            "webm",
            "wmv",
            "wtv"
          ],
          "name": "Video Player",
          "description": "Video Player media file",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Player",
      "artifactName": "VideoPlayer-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "VideoPlayer-Portable-${version}.exe"
    }
  }
}